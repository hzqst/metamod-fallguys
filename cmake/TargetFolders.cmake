# Assign solution folders after all components and their dependencies exist.
function(mmfg_assign_solution_folders)
    set(_pending "${CMAKE_CURRENT_SOURCE_DIR}")
    while(_pending)
        list(POP_FRONT _pending _directory)
        get_property(_subdirectories DIRECTORY "${_directory}" PROPERTY SUBDIRECTORIES)
        list(APPEND _pending ${_subdirectories})
        get_property(_targets DIRECTORY "${_directory}" PROPERTY BUILDSYSTEM_TARGETS)
        get_property(_binary_dir DIRECTORY "${_directory}" PROPERTY BINARY_DIR)

        # Vendor build paths stay fixed even when sources are overridden or fetched.
        # Check them first: nested vendor sources also lie inside component roots.
        set(_folder "")
        foreach(_dependency Bullet Capstone Procmap)
            string(TOLOWER "${_dependency}" _dependency_dir)
            set(_dependency_root "${CMAKE_CURRENT_BINARY_DIR}/vendor/${_dependency_dir}")
            cmake_path(IS_PREFIX _dependency_root "${_binary_dir}" NORMALIZE _is_dependency)
            if(_is_dependency)
                set(_folder "ThirdParty/${_dependency}")
                break()
            endif()
        endforeach()
        if(_folder STREQUAL "")
            foreach(_component IN LISTS MMFG_COMPONENTS)
                set(_component_root "${CMAKE_CURRENT_SOURCE_DIR}/${_component}")
                cmake_path(IS_PREFIX _component_root "${_directory}" NORMALIZE _is_component)
                if(_is_component)
                    set(_folder "${_component}")
                    break()
                endif()
            endforeach()
        endif()

        if(NOT _folder STREQUAL "")
            foreach(_target IN LISTS _targets)
                get_target_property(_existing_folder "${_target}" FOLDER)
                # Explicit folders, including FormatValidation and CTest, win.
                if(_existing_folder STREQUAL "" OR _existing_folder STREQUAL "_existing_folder-NOTFOUND")
                    set_target_properties("${_target}" PROPERTIES FOLDER "${_folder}")
                endif()
            endforeach()
        endif()
    endwhile()
endfunction()
