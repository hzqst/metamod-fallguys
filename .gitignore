.vs
/.clang-format
settings.local.json

# CMake / native build output
/output
/intermediate
/install
/Debug
/Release
/build-cmake
/build/addons/metamod/dlls
/thirdparty/build
/thirdparty/install

# Legacy per-module object directories (kept ignored so a stray native build
# can never re-introduce them into the repository)
opt.*/
debug.*/
msgs/

# Compiled objects and libraries are never committed; only CMake produces them.
*.o
*.obj
*.so
*.a
*.lib
*.pdb
*.exp

# Basic Memory runtime data (notes under memory/ are tracked)
memory/*.db*
memory/config.json
